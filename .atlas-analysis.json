  "keyFeatures": [
    "Slash commands, buttons, select menus, and modals for modern Discord interactions",
    "Multiple database support: MySQL, PostgreSQL, and SQLite",
    "Ticket archiving and HTML transcript generation",
    "Customisable categories with question forms (up to 5 questions per ticket)",
    "Tags system to resolve member issues without creating tickets",
    "Auto-close inactive tickets with configurable timeouts",
    "Staff tools: claim, release, move, transfer, and rename tickets",
    "Feedback and rating system with staff performance statistics",
    "Built-in dashboard for configuration via web UI",
    "Docker support for quick and reliable deployment",
    "Internationalisation with 10+ supported languages",
    "Ticket references to link related tickets or messages"
  ],
  "publicApiSurface": [
    "GET /api/guilds - List guilds",
    "GET /api/guilds/:guild - Get guild details",
    "GET /api/guilds/:guild/tickets - List tickets for a guild",
    "GET /api/users/:user - Get user details",
    "GET /api/locales - Get available locales",
    "GET /api/client - Get bot client info",
    "/new - Create a new ticket",
    "/close - Close a ticket",
    "/add - Add a member to a ticket",
    "/remove - Remove a member from a ticket",
    "/claim - Claim a ticket as staff",
    "/release - Release a claimed ticket",
    "/move - Move a ticket to another category",
    "/transfer - Transfer ticket ownership",
    "/rename - Rename a ticket channel",
    "/tag - Send a tag response",
    "/tickets - List your tickets",
    "/transcript - Generate ticket transcript",
    "/topic - Change ticket topic",
    "/priority - Set ticket priority",
    "/force-close - Force close a ticket",
    "/help - Show help information"
  ]
}
